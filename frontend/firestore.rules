rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isAuthenticated() &&
        getUserData() != null &&
        getUserData().role == 'admin';
    }

    function isStudent() {
      return isAuthenticated() &&
        getUserData() != null &&
        getUserData().role == 'student';
    }

    function isApprovedStudent() {
      return isStudent() &&
        getUserData().approved == true;
    }

    // Korisnici
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isStaff() || (request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved']));
      allow delete: if isStaff();
    }

    // Termini (slots)
    match /slots/{slotId} {
      allow read: if isAuthenticated();
      allow create, delete: if isStaff();
      allow update: if isAuthenticated();
    }

    // Rezervacije
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isApprovedStudent() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() ||
        (isApprovedStudent() && resource.data.userId == request.auth.uid);
      allow delete: if isStaff() ||
        (isApprovedStudent() && resource.data.userId == request.auth.uid);
    }

    // Kartični ulasci
    match /card_entries/{entryId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // Zabranjeni datumi
    match /blocked_dates/{dateId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Kvarovi
    match /kvarovi/{kvarId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }
  }
  // Settings
match /settings/{docId} {
  allow read: if isAuthenticated();
  allow write: if isStaff();
}
}
