// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: readable by self, writable by self on register
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid;
    }

    // Slots: all authenticated can read; only enrolled-self writes
    match /slots/{slotId} {
      allow read: if request.auth != null;
      // Student can only add/remove themselves from enrolled array
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolled'])
        && (
          // enrolling themselves
          (request.resource.data.enrolled == resource.data.enrolled + [request.auth.uid])
          // unenrolling themselves
          || (resource.data.enrolled == request.resource.data.enrolled + [request.auth.uid])
        );
      // Admin can do anything
      allow write: if isAdmin();
    }

    // Kvarovi: read/write only admin
    match /kvarovi/{id} {
      allow read, write: if isAdmin();
    }

    // Settings: read any auth, write admin
    match /settings/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Notifications: write admin, read any auth
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
